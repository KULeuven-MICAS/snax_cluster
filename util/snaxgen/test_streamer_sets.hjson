// The smallest cluster test_snaxgen.py needs: one accelerator entry with two streamer
// sets, shaped like snax-forge's dot 1 (vmul: two readers and a writer of 8 channels;
// vsum: a reader of 8 and a writer of 1; each mover one spatial and one temporal loop).
// Only snaxgen reads it, in sw_only mode.
{
  "cluster": {
    "data_width": 64,
    "dma_data_width": 512,
    "tcdm": {"size": 128, "banks": 32},
    "hives": [
      {
        "cores": [
          {
            "snax_acc_cfg": [
              {
                "snax_acc_name": "snaxgen_sets_test",
                "snax_tcdm_ports": 33,
                "snax_disable_csr_manager": true,
                "snax_streamer_sets": [
                  {
                    "name": "vmul",
                    "snax_num_rw_csr": 2,
                    "snax_num_ro_csr": 2,
                    "snax_streamer_cfg": {
                      "data_reader_params": {
                        "spatial_bounds": [[8], [8]],
                        "temporal_dim": [1, 1],
                        "num_channel": [8, 8],
                        "fifo_depth": [8, 8]
                      },
                      "data_writer_params": {
                        "spatial_bounds": [[8]],
                        "temporal_dim": [1],
                        "num_channel": [8],
                        "fifo_depth": [8]
                      }
                    }
                  },
                  {
                    "name": "vsum",
                    "snax_num_rw_csr": 3,
                    "snax_num_ro_csr": 2,
                    "snax_streamer_cfg": {
                      "data_reader_params": {
                        "spatial_bounds": [[8]],
                        "temporal_dim": [1],
                        "num_channel": [8],
                        "fifo_depth": [8]
                      },
                      "data_writer_params": {
                        "spatial_bounds": [[1]],
                        "temporal_dim": [1],
                        "num_channel": [1],
                        "fifo_depth": [8]
                      }
                    }
                  }
                ]
              }
            ]
          },
          {}
        ]
      }
    ]
  }
}
