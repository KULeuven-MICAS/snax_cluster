{
    // ROWS must be 32 -- the FP16 lane count of a 512-bit beat. The transposed path puts
    // one token per lane, so a whole tile's per-token max and sum are exactly one beat.
    ROWS: 32,
    // Row length in FP16 elements, a multiple of 32. Also bounded by the on-device
    // reciprocal: 1/s is rsqrt(s*s) and s <= D, so D*D must fit FP16 (D <= 255 in the
    // worst case). The datagen checks what this tile actually reaches.
    D: 128,
}
