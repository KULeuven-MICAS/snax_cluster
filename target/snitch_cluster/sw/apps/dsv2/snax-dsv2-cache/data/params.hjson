{
    // The golden pack (sw/apps/dsv2/util): L tokens cached, the new token at position L.
    seed: 1,
    L: 511,
    // Tokens the two DRAM copies hold (a multiple of 16), and the appends to run.
    capacity: 576,
    appends: 3,
}
