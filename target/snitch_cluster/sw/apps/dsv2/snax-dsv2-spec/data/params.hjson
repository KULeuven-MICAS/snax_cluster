{
    // Four tokens per pass (I7): the token at a pass's start and three drafts after it. Pass 0
    // runs positions L .. L + 3; pass 1 starts at L + 2 -- pass 0's first draft was accepted, its
    // second rejected -- so it overwrites the rows of L + 2 and L + 3, and reads the rows of L and
    // L + 1 that pass 0 kept.
    seed: 1,
    L: 100,
    bc: 64,
    ntok: 4,
    starts: [100, 102],
    // Tokens the two DRAM cache copies hold: every pass's rows, in whole tiles of bc.
    capacity: 128,
    // TEST SIZE: this app is a unit test, so the model is DeepSeek-V2-Lite with a narrower hidden
    // state and narrower experts, and each token routed to its top 2 (util/golden.py
    // make(dims)): four tokens stream the union of their experts, at most 8 slots instead of 24.
    // The cache is short (two key tiles, the last partial). snax-dsv2-layer runs the top 6. The
    // full layer runs on HeMAiA; drop `dims` and set L: 511, starts: [511, 513], capacity: 576
    // to run it here.
    dims: {hidden: 256, moe_inter: 128, top_k: 2},
}
