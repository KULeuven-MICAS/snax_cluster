{
    // The golden pack (sw/apps/dsv2/util): random weights at DeepSeek-V2-Lite's shapes, one
    // token at position L with L tokens cached.
    seed: 1,
    L: 63,
    // Output columns per streamed weight chunk: a K x 64 B-layout block, finished outputs.
    chunk: 64,
    // The GEMV shapes to run, in order. The router doubles as the D-port negative control.
    shapes: ["wq", "wdkv", "wo", "router", "expert_gu", "expert_down", "shared_gu", "shared_down"],
    // TEST SIZE: this app is a unit test, so each shape runs its first `chunks` chunks of
    // columns (every depth and shift, about a twentieth of the weight bytes). The full shapes run on HeMAiA;
    // drop `chunks` to run every column here.
    chunks: 2,
}
