{
    // The golden pack (sw/apps/dsv2/util): random weights at DeepSeek-V2-Lite's shapes, one
    // token at position L with L tokens cached.
    seed: 1,
    L: 511,
    // Heads per GEMM task. A head's weight is 64 KiB, so a task's B buffer is 64 KiB times
    // this, twice over for double buffering; all 16 heads (1 MiB) would be the whole 1 MiB L1.
    heads_per_task: 2,
}
