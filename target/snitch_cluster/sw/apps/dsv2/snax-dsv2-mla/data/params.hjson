{
    // The golden pack (sw/apps/dsv2/util): random weights at DeepSeek-V2-Lite's shapes, one
    // token at position L with L tokens cached. The token appends its own row, so the
    // attention runs over L + 1 keys, which must fill whole tiles of bc.
    seed: 1,
    L: 511,
    bc: 64,
    // Tokens the two DRAM cache copies hold.
    capacity: 576,
}
