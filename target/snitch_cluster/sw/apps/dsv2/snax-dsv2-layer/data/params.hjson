{
    // The golden pack (sw/apps/dsv2/util): random weights, L tokens cached. Pass p runs ntok
    // tokens from position starts[p]; each appends its rows, which the passes after it read
    // (golden.spec_passes).
    seed: 1,
    L: 100,
    bc: 64,
    ntok: 1,
    starts: [100, 101],
    // Tokens the two DRAM cache copies hold: every pass's rows, in whole tiles of bc.
    capacity: 128,
    // TEST SIZE: this app is a unit test, so the model is DeepSeek-V2-Lite with a narrower hidden
    // state and narrower experts (util/golden.py make(dims)), the cache short (two key tiles, the
    // last partial) and the passes two: the second reads the row the first appended. The full
    // layer runs on HeMAiA; drop `dims` and set L: 511, starts: [511, 512, 513], capacity: 576
    // to run it here.
    dims: {hidden: 256, moe_inter: 256},
}
