// One native 512-bit XDMA port per side spans eight unchanged 64-bit banks.
{
    nr_s1_quadrant: 1,
    s1_quadrant: { nr_clusters: 1 },
    cluster: {
        name: "snax_xdma_wide_cluster",
        bender_target: ["snitch_cluster", "snax_xdma_wide_cluster", "sparse_interconnect"],
        boot_addr: 4096,
        cluster_base_addr: 268435456,
        cluster_base_offset: 4194304,
        cluster_base_hartid: 0,
        addr_width: 48,
        data_width: 64,
        dma_data_width: 512,
        xdma_use_wide_tcdm: true,
        cluster_periph_size: 64,
        zero_mem_size: 64,
        dma_axi_req_fifo_depth: 16,
        dma_req_fifo_depth: 8,
        narrow_trans: 4,
        wide_trans: 32,
        observable_pin_width: 8,
        timing: { $ref: "snax_alu_cluster.hjson#/cluster/timing" },
        user_width: 3,
        dma_user_width: 1,
        tcdm: { size: 128, banks: 32, sparse_interconnect: true },
        enable_debug: false,
        vm_support: false,
        sram_cfg_expose: true,
        sram_cfg_fields: { ema: 3, emaw: 2, emas: 1 },
        hives: [{
            icache: { size: 8, sets: 2, cacheline: 256 },
            cores: [
                {
                    isa: "rv32ima",
                    xssr: false,
                    xfrep: false,
                    xdma: false,
                    num_int_outstanding_loads: 1,
                    num_int_outstanding_mem: 4
                },
                {
                    isa: "rv32ima",
                    xssr: false,
                    xfrep: false,
                    num_int_outstanding_loads: 1,
                    num_int_outstanding_mem: 4,
                    xdma: true,
                    snax_xdma_cfg: {
                        bender_target: ["snax_xdma_wide_cluster_xdma"],
                        cfg_io_width: 32,
                        max_multicast: 2,
                        max_dimension: 5,
                        max_mem_size_kiB: 4096,
                        reader_buffer: 4,
                        writer_buffer: 4,
                        reader_agu_temporal_dimension: 5,
                        writer_agu_temporal_dimension: 5,
                        reader_extensions: {},
                        writer_extensions: {}
                    }
                }
            ]
        }]
    },
    dram: { address: 2147483648, length: 2147483648 },
    peripherals: { clint: { address: 4294901760, length: 4096 } }
}
