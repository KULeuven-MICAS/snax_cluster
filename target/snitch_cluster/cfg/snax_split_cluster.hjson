{
    nr_s1_quadrant: 1
    s1_quadrant:
    {
        nr_clusters: 1
    }
    cluster:
    {
        name: snax_split_cluster
        bender_target:
        [
            snitch_cluster
            snax_split_cluster
        ]
        boot_addr: 4096
        cluster_base_addr: 268435456
        cluster_base_offset: 4194304
        cluster_base_hartid: 0
        addr_width: 48
        data_width: 64
        user_width: 3
        tcdm:
        {
            size: 512
            banks: 32
            sparse_interconnect: false
        }
        cluster_periph_size: 64
        zero_mem_size: 64
        dma_data_width: 512
        dma_axi_req_fifo_depth: 16
        dma_req_fifo_depth: 8
        observable_pin_width: 8
        narrow_trans: 4
        wide_trans: 32
        dma_user_width: 1
        enable_debug: false
        vm_support: false
        sram_cfg_expose: true
        sram_cfg_fields:
        {
            ema: 3
            emaw: 2
            emas: 1
        }
        timing:
        {
            lat_comp_fp32: 3
            lat_comp_fp64: 3
            lat_comp_fp16: 2
            lat_comp_fp16_alt: 2
            lat_comp_fp8: 1
            lat_comp_fp8_alt: 1
            lat_noncomp: 1
            lat_conv: 1
            lat_sdotp: 2
            fpu_pipe_config: BEFORE
            narrow_xbar_latency: CUT_ALL_PORTS
            wide_xbar_latency: CUT_ALL_PORTS
            register_core_req: true
            register_core_rsp: true
            register_offload_req: true
            register_offload_rsp: true
            register_ext_narrow: true
            register_ext_wide: true
        }
        hives:
        [
            {
                icache:
                {
                    size: 8
                    sets: 2
                    cacheline: 256
                }
                cores:
                [
                    {
                        isa: rv32ima
                        xssr: false
                        xfrep: false
                        xdma: false
                        xf16: false
                        xf16alt: false
                        xf8: false
                        xf8alt: false
                        xfdotp: false
                        xfvec: false
                        snax_acc_cfg:
                        [
                            {
                                snax_acc_name: snax_streamer_gemmX
                                bender_target:
                                [
                                    snax_gemmX
                                ]
                                snax_tcdm_ports: 56
                                snax_num_rw_csr: 29  // = 4 + (2 + meshCol/4 + meshCol + 1) + 2, by hand; 19 at meshCol=8
                                snax_num_ro_csr: 2
                                // 16x4x16 = 1024 INT8 MAC/cycle, double 8x8x8, at IDENTICAL operand
                                // bandwidth: operand bytes/MAC = 1/meshRow + 1/meshCol, independent of
                                // tileSize, so A stays meshRow*tileSize = 64 B and B stays
                                // tileSize*meshCol = 64 B and the streamer ports are unchanged.
                                snax_gemmx_mesh_row: 16
                                snax_gemmx_tile_size: 4
                                snax_gemmx_mesh_col: 16
                                snax_gemmx_serial_c32_d32_width: 2048
                                snax_gemmx_serial_d8_width: 512
                                with_pipeline: true
                                snax_streamer_cfg:
                                {
                                    data_reader_params:
                                    {
                                        spatial_bounds:
                                        [
                                            [
                                                8
                                            ]
                                            [
                                                8
                                            ]
                                        ]
                                        temporal_dim:
                                        [
                                            6
                                            3
                                        ]
                                        num_channel:
                                        [
                                            8
                                            8
                                        ]
                                        fifo_depth:
                                        [
                                            8
                                            8
                                        ]
                                        configurable_channel:
                                        [
                                            0
                                            0
                                        ]
                                        tcdm_logic_word_size:
                                        [
                                            [
                                                256
                                                128
                                                64
                                            ]
                                            [
                                                256
                                                128
                                                64
                                            ]
                                        ]
                                        datapath_extensions:
                                        [
                                            {
                                                HasTransposer:
                                                {
                                                    row:
                                                    [
                                                        8
                                                    ]
                                                    col:
                                                    [
                                                        8
                                                    ]
                                                    elementWidth:
                                                    [
                                                        8
                                                    ]
                                                }
                                            }
                                            {
                                                HasTransposer:
                                                {
                                                    row:
                                                    [
                                                        8
                                                    ]
                                                    col:
                                                    [
                                                        8
                                                    ]
                                                    elementWidth:
                                                    [
                                                        8
                                                    ]
                                                }
                                            }
                                        ]
                                    }
                                    data_writer_params:
                                    {
                                        spatial_bounds:
                                        [
                                            [
                                                8
                                            ]
                                        ]
                                        temporal_dim:
                                        [
                                            3
                                        ]
                                        num_channel:
                                        [
                                            8
                                        ]
                                        fifo_depth:
                                        [
                                            1
                                        ]
                                        configurable_channel:
                                        [
                                            0
                                        ]
                                        tcdm_logic_word_size:
                                        [
                                            [
                                                256
                                                128
                                                64
                                            ]
                                        ]
                                    }
                                    data_reader_writer_params:
                                    {
                                        spatial_bounds:
                                        [
                                            [
                                                8
                                                4
                                            ]
                                            [
                                                8
                                                4
                                            ]
                                        ]
                                        temporal_dim:
                                        [
                                            3
                                            3
                                        ]
                                        num_channel:
                                        [
                                            32
                                            32
                                        ]
                                        fifo_depth:
                                        [
                                            1
                                            1
                                        ]
                                        configurable_channel:
                                        [
                                            1
                                            0
                                        ]
                                        tcdm_logic_word_size:
                                        [
                                            [
                                                256
                                                128
                                                64
                                            ]
                                            [
                                                256
                                                128
                                                64
                                            ]
                                        ]
                                        datapath_extensions:
                                        [
                                            {
                                                HasBroadcaster:
                                                {
                                                    inputLength: 256
                                                    outputLength: 2048
                                                }
                                            }
                                            // Slots are [read, write]: slot 0 is C's read path
                                            // (the broadcaster), slot 1 is the D32 write path.
                                            {
                                                HasInt32ToFp16Converter:
                                                {
                                                    // 2048 = 32 TCDM channels x 64 b
                                                    dataWidth: 2048
                                                }
                                            }
                                        ]
                                    }
                                    has_transpose: true
                                    has_C_broadcast: true
                                    // Must match the Chisel streamer_csr_addr_map.h: the converter
                                    // adds its user CSR (the flag) plus the enable of the D32
                                    // extension host, which was empty before (the explicit +1).
                                    has_int32_to_fp16_converter: true
                                    extra_streamer_csr: 1
                                    snax_library_name: gemmx
                                }
                            }
                        ]
                        snax_use_custom_ports: false
                        num_int_outstanding_loads: 1
                        num_int_outstanding_mem: 4
                        num_fp_outstanding_loads: 4
                        num_fp_outstanding_mem: 4
                        num_sequencer_instructions: 16
                        num_dtlb_entries: 1
                        num_itlb_entries: 1
                    }
                    {
                        isa: rv32ima
                        snax_simd_cfg:
                        {
                            bender_target:
                            [
                                snax_split_cluster_simd
                            ]
                            cfg_io_width: 32
                            num_channel: 8
                            reader_buffer: 12
                            writer_buffer: 12
                            reader_agu_temporal_dimension: 3
                            writer_agu_temporal_dimension: 3
                            reader_extensions:
                            [
                                // ORDER IS THE CHAIN ORDER: a task arms a subset with the enable bitmask and
                                // data flows through the armed stages in declaration order, so what can be
                                // fused into ONE pass over memory is decided HERE.
                                //
                                // Read the order as the epilogue of a quantised layer:
                                //     combine -> transform -> reduce -> combine -> narrow
                                //
                                // The INT32 -> FP16 convert belongs to the PRODUCER, not here: an INT32
                                // beat carries half as many values as an FP16 one, so converting at the
                                // consumer doubles both the beats it reads and the TCDM the tile occupies.
                                // It now sits on the GEMM's own D32 output port.
                                //
                                // ElementwiseAdd (INT32) used to lead this chain; it is gone, because with
                                // no INT32 entering the SIMD it had nothing upstream and only its own test
                                // downstream. Every stage below is FP16 transport / FP32 internal.
                                // ARRAY form (not the keyed object): a JSON object cannot repeat a key, and
                                // StreamElementwise has to appear TWICE -- see below.
                                // PRE-MAP elementwise. The chain is a fixed linear order, so it can express
                                // reduce(f(x)) but not f(x - s): a combine against a broadcast operand that
                                // must happen BEFORE the pointwise transform has nowhere to go. Two important
                                // kernels need exactly that and today pay an extra full pass over the tile:
                                //   - attention's second pass, quantise(exp(S - m))
                                //   - dequantise-then-activate, the standard quantised-inference epilogue
                                // One more instance is about a StreamMap's worth of area and removes a whole
                                // pass; a general routing crossbar over the chain would cost far more and put
                                // muxes in the critical path of a wire-speed pipeline.
                                {
                                    HasStreamElementwise:
                                    {
                                        dataWidth: 512
                                        elementWidth: 16
                                        computeLanes: 16
                                        op:
                                        [
                                            FMA_FP16
                                        ]
                                        fpPipe: 1
                                    }
                                }
                                {
                                    HasStreamMap:
                                    {
                                        dataWidth: 512
                                        elementWidth: 16
                                        computeLanes: 16
                                        func:
                                        [
                                            LINEAR_FP16
                                            EXP_FP16
                                            SILU_FP16
                                        ]
                                        fpPipe: 1
                                    }
                                }
                                // accPartials 4.
                                //
                                // The accumulate recurrence needs subCycles*accPartials >= accLat+1 = 4. With a
                                // single bank that caps computeLanes at lanes/4 = 8; four rotating partials make
                                // the same bank re-read only every accPartials*subCycles cycles, which lifts the
                                // cap entirely -- the lane count is then free to be chosen on area/throughput
                                // grounds rather than forced by the recurrence.
                                //
                                // Cost: three extra banks of lanes x FP32 partial registers plus a per-lane
                                // combinational fold at the row boundary. NOTE a short row (fewer beats than
                                // accPartials) leaves the top banks holding the PREVIOUS task's partials --
                                // the fold masks them to the op's identity, see StreamReduce.banksUsed.
                                {
                                    HasStreamReduce:
                                    {
                                        dataWidth: 512
                                        elementWidth: 16
                                        computeLanes: 16
                                        op:
                                        [
                                            FMA_FP16
                                            MAX_FP16
                                        ]
                                        fpPipe: 1
                                        treePipe: 1
                                        treeLanes: 2
                                        accPartials: 4
                                    }
                                }
                                // POST-MAP elementwise: SwiGLU (silu(a)*b) and any scale-after-reduce need the
                                // combine on this side of the map. Same operator, other position.
                                {
                                    HasStreamElementwise:
                                    {
                                        dataWidth: 512
                                        elementWidth: 16
                                        computeLanes: 16
                                        op:
                                        [
                                            FMA_FP16
                                        ]
                                        fpPipe: 1
                                    }
                                }
                                {
                                    HasFp16ToInt8:
                                    {
                                        in_elementWidth: 16
                                        out_elementWidth: 8
                                        dataWidth: 512
                                        computeLanes: 16
                                        fpPipe: 1
                                    }
                                }
                            ]
                        }
                        xdma: false
                        xssr: false
                        xfrep: false
                        xf16: false
                        xf16alt: false
                        xf8: false
                        xf8alt: false
                        xfdotp: false
                        xfvec: false
                        num_int_outstanding_loads: 1
                        num_int_outstanding_mem: 4
                        num_fp_outstanding_loads: 4
                        num_fp_outstanding_mem: 4
                        num_sequencer_instructions: 16
                        num_dtlb_entries: 1
                        num_itlb_entries: 1
                    }
                    {
                        isa: rv32ima
                        snax_xdma_cfg:
                        {
                            bender_target:
                            [
                                snax_split_cluster_xdma
                            ]
                            cfg_io_width: 32
                            max_multicast: 16
                            max_dimension: 5
                            max_mem_size_kiB: 65536
                            reader_buffer: 12
                            writer_buffer: 12
                            reader_agu_temporal_dimension: 5
                            writer_agu_temporal_dimension: 5
                            writer_extensions:
                            {
                                HasVerilogMemset: {}
                            }
                            writer_junctions:
                            {
                                HasElementwiseJunction:
                                {
                                    dataWidth: 512
                                    elemWidth: 16
                                    fpPipe: 1
                                }
                                HasMonoidJunction:
                                {
                                    dataWidth: 512
                                    fpPipe: 1
                                    expLutN: 128
                                }
                                HasTopKJunction:
                                {
                                    dataWidth: 512
                                    k: 8
                                }
                                HasBitwiseJunction:
                                {
                                    dataWidth: 512
                                }
                            }
                            // Reader-side extension socket on the xDMA.
                            //
                            // The four-engine split moved the compute extensions to the SIMD
                            // block and emptied this list. But the Transposer is not compute --
                            // it is a pure wire permutation, matrixOutput(j)(i) := matrixInput(i)(j)
                            // -- so it belongs with data movement, and with the list empty there
                            // was nowhere on this cluster for snax-xdma-transpose to run at all.
                            //
                            // Same declaration as the unsplit cluster, so it generates the id
                            // TRANSPOSERROW8_8COL8_8BIT8_16 that the kernel selects first.
                            //
                            // NOTE: this is the ONLY reader_extensions key in this block. Adding a
                            // second one earlier silently did nothing -- a later duplicate key wins.
                            reader_extensions:
                            {
                                HasTransposer: {row:[8,8], col:[8,8], elementWidth:[8,16]}
                            }
                        }
                        xdma: false
                        xssr: false
                        xfrep: false
                        xf16: false
                        xf16alt: false
                        xf8: false
                        xf8alt: false
                        xfdotp: false
                        xfvec: false
                        num_int_outstanding_loads: 1
                        num_int_outstanding_mem: 4
                        num_fp_outstanding_loads: 4
                        num_fp_outstanding_mem: 4
                        num_sequencer_instructions: 16
                        num_dtlb_entries: 1
                        num_itlb_entries: 1
                    }
                    {
                        isa: rv32ima
                        xdma: true
                        xssr: false
                        xfrep: false
                        xf16: false
                        xf16alt: false
                        xf8: false
                        xf8alt: false
                        xfdotp: false
                        xfvec: false
                        num_int_outstanding_loads: 1
                        num_int_outstanding_mem: 4
                        num_fp_outstanding_loads: 4
                        num_fp_outstanding_mem: 4
                        num_sequencer_instructions: 16
                        num_dtlb_entries: 1
                        num_itlb_entries: 1
                    }
                ]
            }
        ]
    }
