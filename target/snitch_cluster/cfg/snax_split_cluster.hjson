{
    nr_s1_quadrant: 1
    s1_quadrant:
    {
        nr_clusters: 1
    }
    cluster:
    {
        name: snax_split_cluster
        bender_target:
        [
            snitch_cluster
            snax_split_cluster
        ]
        boot_addr: 4096
        cluster_base_addr: 268435456
        cluster_base_offset: 4194304
        cluster_base_hartid: 0
        addr_width: 48
        data_width: 64
        user_width: 3
        tcdm:
        {
            size: 512
            banks: 32
            sparse_interconnect: false
        }
        cluster_periph_size: 64
        zero_mem_size: 64
        dma_data_width: 512
        dma_axi_req_fifo_depth: 16
        dma_req_fifo_depth: 8
        observable_pin_width: 8
        narrow_trans: 4
        wide_trans: 32
        dma_user_width: 1
        enable_debug: false
        vm_support: false
        sram_cfg_expose: true
        sram_cfg_fields:
        {
            ema: 3
            emaw: 2
            emas: 1
        }
        timing:
        {
            lat_comp_fp32: 3
            lat_comp_fp64: 3
            lat_comp_fp16: 2
            lat_comp_fp16_alt: 2
            lat_comp_fp8: 1
            lat_comp_fp8_alt: 1
            lat_noncomp: 1
            lat_conv: 1
            lat_sdotp: 2
            fpu_pipe_config: BEFORE
            narrow_xbar_latency: CUT_ALL_PORTS
            wide_xbar_latency: CUT_ALL_PORTS
            register_core_req: true
            register_core_rsp: true
            register_offload_req: true
            register_offload_rsp: true
            register_ext_narrow: true
            register_ext_wide: true
        }
        hives:
        [
            {
                icache:
                {
                    size: 8
                    sets: 2
                    cacheline: 256
                }
                cores:
                [
                    {
                        // hart 0: the matmul engine -- see snax_versacore_core_template.
                        $ref: "#/snax_versacore_core_template"
                    }
                    {
                        // hart 1: the SIMD operator bank on its own core.
                        roles: ["simd"]
                        isa: rv32ima
                        snax_simd_cfg:
                        {
                            bender_target:
                            [
                                snax_split_cluster_simd
                            ]
                            cfg_io_width: 32
                            num_channel: 8
                            reader_buffer: 12
                            writer_buffer: 12
                            reader_agu_temporal_dimension: 3
                            writer_agu_temporal_dimension: 3
                            reader_extensions:
                            [
                                // ORDER IS THE CHAIN ORDER: a task arms a subset with the enable bitmask and
                                // data flows through the armed stages in declaration order, so what can be
                                // fused into ONE pass over memory is decided HERE.
                                //
                                // Read the order as the epilogue of a quantised layer:
                                //     combine -> transform -> reduce -> combine -> narrow
                                //
                                // The INT32 -> FP16 convert belongs to the PRODUCER, not here: an INT32
                                // beat carries half as many values as an FP16 one, so converting at the
                                // consumer doubles both the beats it reads and the TCDM the tile occupies.
                                // It sits on the GEMM's own D32 output port.
                                //
                                // Every stage below is FP16 transport, FP32 internal. No INT32 reaches the
                                // SIMD, so an INT32 elementwise stage would have nothing upstream of it.
                                // ARRAY form (not the keyed object): a JSON object cannot repeat a key, and
                                // StreamElementwise has to appear TWICE -- see below.
                                // PRE-MAP elementwise. The chain is a fixed linear order, so it can express
                                // reduce(f(x)) but not f(x - s): a combine against a broadcast operand that
                                // must happen BEFORE the pointwise transform has nowhere to go. Two important
                                // kernels need exactly that and today pay an extra full pass over the tile:
                                //   - attention's second pass, quantise(exp(S - m))
                                //   - dequantise-then-activate, the standard quantised-inference epilogue
                                // One more instance is about a StreamMap's worth of area and removes a whole
                                // pass; a general routing crossbar over the chain would cost far more and put
                                // muxes in the critical path of a wire-speed pipeline.
                                {
                                    HasStreamElementwise:
                                    {
                                        dataWidth: 512
                                        elementWidth: 16
                                        computeLanes: 16
                                        op:
                                        [
                                            FMA_FP16
                                        ]
                                        fpPipe: 1
                                    }
                                }
                                {
                                    HasStreamMap:
                                    {
                                        dataWidth: 512
                                        elementWidth: 16
                                        computeLanes: 16
                                        func:
                                        [
                                            LINEAR_FP16
                                            EXP_FP16
                                            SILU_FP16
                                        ]
                                        fpPipe: 1
                                    }
                                }
                                // accPartials 4.
                                //
                                // The accumulate recurrence needs subCycles*accPartials >= accLat+1 = 4. With a
                                // single bank that caps computeLanes at lanes/4 = 8; four rotating partials make
                                // the same bank re-read only every accPartials*subCycles cycles, which lifts the
                                // cap entirely -- the lane count is then free to be chosen on area/throughput
                                // grounds rather than forced by the recurrence.
                                //
                                // Cost: three extra banks of lanes x FP32 partial registers plus a per-lane
                                // combinational fold at the row boundary. NOTE a short row (fewer beats than
                                // accPartials) leaves the top banks holding the PREVIOUS task's partials --
                                // the fold masks them to the op's identity, see StreamReduce.banksUsed.
                                {
                                    HasStreamReduce:
                                    {
                                        dataWidth: 512
                                        elementWidth: 16
                                        computeLanes: 16
                                        op:
                                        [
                                            FMA_FP16
                                            MAX_FP16
                                        ]
                                        fpPipe: 1
                                        treePipe: 1
                                        treeLanes: 2
                                        accPartials: 4
                                    }
                                }
                                // POST-MAP elementwise: SwiGLU (silu(a)*b) and any scale-after-reduce need the
                                // combine on this side of the map. Same operator, other position.
                                {
                                    HasStreamElementwise:
                                    {
                                        dataWidth: 512
                                        elementWidth: 16
                                        computeLanes: 16
                                        op:
                                        [
                                            FMA_FP16
                                        ]
                                        fpPipe: 1
                                    }
                                }
                                {
                                    HasFp16ToInt8:
                                    {
                                        in_elementWidth: 16
                                        out_elementWidth: 8
                                        dataWidth: 512
                                        computeLanes: 16
                                        fpPipe: 1
                                    }
                                }
                            ]
                        }
                        xdma: false
                        xssr: false
                        xfrep: false
                        xf16: false
                        xf16alt: false
                        xf8: false
                        xf8alt: false
                        xfdotp: false
                        xfvec: false
                        num_int_outstanding_loads: 1
                        num_int_outstanding_mem: 4
                        num_fp_outstanding_loads: 4
                        num_fp_outstanding_mem: 4
                        num_sequencer_instructions: 16
                        num_dtlb_entries: 1
                        num_itlb_entries: 1
                    }
                    {
                        // hart 2: the SNAX transfer engine. `xdma: false` below is the
                        // Snitch DMA ISA, a DIFFERENT thing that lives on hart 3 -- the
                        // two keys are confusingly named and this cfg is where they come
                        // apart.
                        roles: ["xdma"]
                        isa: rv32ima
                        snax_xdma_cfg:
                        {
                            bender_target:
                            [
                                snax_split_cluster_xdma
                            ]
                            cfg_io_width: 32
                            max_multicast: 16
                            max_dimension: 5
                            max_mem_size_kiB: 65536
                            reader_buffer: 12
                            writer_buffer: 12
                            reader_agu_temporal_dimension: 5
                            writer_agu_temporal_dimension: 5
                            writer_extensions:
                            {
                                HasVerilogMemset: {}
                            }
                            writer_junctions:
                            {
                                HasElementwiseJunction:
                                {
                                    dataWidth: 512
                                    elemWidth: 16
                                    fpPipe: 1
                                }
                                HasMonoidJunction:
                                {
                                    dataWidth: 512
                                    fpPipe: 1
                                    expLutN: 128
                                }
                                HasTopKJunction:
                                {
                                    dataWidth: 512
                                    k: 8
                                }
                                HasBitwiseJunction:
                                {
                                    dataWidth: 512
                                }
                            }
                            // Reader-side extension socket on the xDMA.
                            //
                            // The compute extensions live on the SIMD block; the Transposer is not
                            // compute -- it is a pure wire permutation,
                            // matrixOutput(j)(i) := matrixInput(i)(j) -- so it belongs with data
                            // movement, and snax-xdma-transpose runs against it here.
                            //
                            // The declaration matches the unsplit cluster, so it generates the id
                            // TRANSPOSERROW8_8COL8_8BIT8_16 that the kernel selects first.
                            //
                            // This must stay the ONLY reader_extensions key in this block: a second
                            // one silently does nothing, because a later duplicate key wins.
                            reader_extensions:
                            {
                                HasTransposer: {row:[8,8], col:[8,8], elementWidth:[8,16]}
                            }
                        }
                        xdma: false
                        xssr: false
                        xfrep: false
                        xf16: false
                        xf16alt: false
                        xf8: false
                        xf8alt: false
                        xfdotp: false
                        xfvec: false
                        num_int_outstanding_loads: 1
                        num_int_outstanding_mem: 4
                        num_fp_outstanding_loads: 4
                        num_fp_outstanding_mem: 4
                        num_sequencer_instructions: 16
                        num_dtlb_entries: 1
                        num_itlb_entries: 1
                    }
                    {
                        // hart 3: the classic Snitch iDMA, and snRuntime's singleton-init
                        // core. Must stay LAST -- snrt_is_dm_core() picks the last hart
                        // structurally, never from this cfg.
                        roles: ["idma"]
                        isa: rv32ima
                        xdma: true
                        xssr: false
                        xfrep: false
                        xf16: false
                        xf16alt: false
                        xf8: false
                        xf8alt: false
                        xfdotp: false
                        xfvec: false
                        num_int_outstanding_loads: 1
                        num_int_outstanding_mem: 4
                        num_fp_outstanding_loads: 4
                        num_fp_outstanding_mem: 4
                        num_sequencer_instructions: 16
                        num_dtlb_entries: 1
                        num_itlb_entries: 1
                    }
                ]
            }
        ]
    }
    dram:
    {
        address: 2147483648
        length: 2147483648
    }
    peripherals:
    {
        clint:
        {
            address: 4294901760
            length: 4096
        }
    }
    // The streamer that feeds VersaCore:
    //
    //   reader 0        A   8 channels x 64 b =  512 b   Mu*Ku INT8
    //   reader 1        B   8 channels x 64 b =  512 b   Ku*Nu INT8
    //   reader_writer   C  32 channels x 64 b = 2048 b   read  (accumulator in)
    //                   D  32 channels x 64 b = 2048 b   write (result out)
    //
    // The reader_writer is ONE bidirectional 32-port set, so the cluster spends
    // 8 + 8 + 32 = 48 TCDM ports. VersaCore has a single D port -- its rescale lives on
    // the streamer's write path, not in the accelerator -- so a quantised output needs no
    // writer of its own.
    //
    // The apps' descriptor arithmetic follows from this layout: Atlstride is
    // a_len*tileSize*meshRow/8, and C/D32 serialise 4:1 over a chunk addressed by TWO
    // spatial strides. The block order reaching TCDM is (m, n, meshRow, meshCol), which
    // is what block_gemm_golden_model() assumes.
    snax_versacore_streamer_template:
    {
        data_reader_params:
        {
            spatial_bounds:
            [
                [
                    8
                ]
                [
                    8
                ]
            ]
            temporal_dim:
            [
                6
                3
            ]
            num_channel:
            [
                8
                8
            ]
            fifo_depth:
            [
                8
                8
            ]
            configurable_channel:
            [
                0
                0
            ]
            tcdm_logic_word_size:
            [
                [
                    256
                    128
                    64
                ]
                [
                    256
                    128
                    64
                ]
            ]
            // NO transposer on A and B.
            //
            // FlashAttention, the GEMM workload here, transposes ALGEBRAICALLY --
            // S^T = K.Q^T is the same GEMM with its operands swapped -- so it has no use
            // for one.
            //
            // Declaring one is also not free. VersaCore's transposer is the flexible one,
            // indexed by the array-shape CSR, and HasTransposer emits that index register
            // only when given MORE THAN ONE shape (userCsrNum = 0 at row.length == 1).
            // With the single 16x4x16 shape here, snax-versacore-to-lib's "write
            // array_shape at base + 1" lands on the NEXT extension's register instead.
            // The xDMA carries its own transposer for data movement.
            datapath_extensions:
            [
                {}
                {}
            ]
        }
        data_reader_writer_params:
        {
            // The inner bound MUST be 4, and the outer one only sets how much of the tile
            // one beat covers. The AGU gives channel i the address
            // sl0*(i % 4) + sl1*((i / 4) % 4), so four channels (4 x 8 B = 32 B) carry ONE
            // key's meshCol FP16 scores and each group steps a WHOLE key row of
            // Br = N*meshCol FP16. That is what interleaves the two N blocks in memory.
            //
            // The inner 4 is the difference between a correct and an incorrect
            // FlashAttention. The score tile leaves the array as [M][N][meshRow][meshCol]
            // blocks; with 8 inner channels a transaction lands 256 B contiguous, so a 64 B
            // beat is 16 queries x 2 KEYS and -- because n alternates every 8 beats -- lane
            // j mixes query j with query j+16, which a LANEWISE reduce cannot recover. Over
            // a full tile that misplaces 15360 of 16384 scores.
            //
            // The outer bound is free because the beat stride absorbs it: 4 groups with a
            // 256 B beat stride enumerate the same addresses in the same order as 8 groups
            // with a 512 B one (0, 64, ... 1984 either way). It is 4 here because the port
            // is 16 channels wide, narrowed from 32 so that a C or D beat claims half the
            // TCDM banks instead of all of them and the A and B readers can still be served.
            //
            // The INT32 side (the O accumulation, converter off) gets a permutation rather
            // than a row-major layout -- one element width can be clean, not both -- but C
            // and D share these strides, so O += P.V still accumulates against itself.
            spatial_bounds:
            [
                [
                    4
                    4
                ]
                [
                    4
                    4
                ]
            ]
            temporal_dim:
            [
                3
                3
            ]
            num_channel:
            [
                16
                16
            ]
            fifo_depth:
            [
                1
                1
            ]
            configurable_channel:
            [
                1
                0
            ]
            tcdm_logic_word_size:
            [
                [
                    256
                    128
                    64
                ]
                [
                    256
                    128
                    64
                ]
            ]
            // Slots are [read, write] for the one reader_writer: slot 0 is the C read
            // path, slot 1 is the D write path.
            //
            // Slot 0 is empty: no app here broadcasts C. FlashAttention sets
            // broadcast_C = 0 and reads a full C, because a serialised C input cannot
            // take a broadcast operand.
            //
            // Slot 1 converts the INT32 result to FP16 on the way out. That is the one
            // extension FlashAttention depends on: the score tile is consumed as FP16 by
            // the SIMD block, and converting HERE rather than in a SIMD pass halves both
            // the beats the writer emits and the TCDM the tile occupies.
            datapath_extensions:
            [
                {}
                {
                    HasInt32ToFp16Converter:
                    {
                        // 1024 = the D port's beat: 16 TCDM channels x 64 b.
                        dataWidth: 1024
                    }
                }
            ]
        }
        // snaxgen sizes the accelerator's CSR window from these flags, and it MUST agree
        // with the Chisel-generated streamer_csr_addr_map.h: the last read-only CSR there
        // must be (base + streamer_csr_num - 1). An undercount leaves the streamer's start
        // register outside the decoded window -- writes are dropped, busy reads back 0,
        // and the accelerator produces zeros with no error anywhere.
        //
        // The converter contributes its own user CSR (the extra-loop policy) via the flag,
        // plus the ENABLE register of the reader_writer WRITE host, which is empty
        // otherwise and which no flag covers -- hence the explicit +1.
        has_int32_to_fp16_converter: true
        extra_streamer_csr: 1
        snax_library_name: versacore-to
    }
    // The matmul array:
    //
    //   spatial unrolling (Mu, Ku, Nu) = (16, 4, 16) = 1024 INT8 MAC/cycle
    //
    // The apps know these three as meshRow / tileSize / meshCol. The operand widths follow
    // from the shape: A is Mu*Ku*8 = 512 b, B is Ku*Nu*8 = 512 b, C and D are
    // Mu*Nu*32 = 8192 b serialised 4:1 onto the 2048 b port.
    //
    // ONE shape and ONE data type, so the array-shape and data-type CSRs are always 0.
    // VersaCore's point is that both are runtime-selectable; a second shape costs area and
    // changes the CSR map (see the transposer note in the streamer template), so it belongs
    // to a deliberate DSE rather than to the default.
    snax_versacore_core_template:
    {
        // The matmul array. Cross-checked against the cfg by util/snaxgen/core_roles.py.
        roles: ["gemm"]
        isa: rv32ima
        xssr: false
        xfrep: false
        xdma: false
        xf16: false
        xf16alt: false
        xf8: false
        xf8alt: false
        xfdotp: false
        xfvec: false
        snax_acc_cfg:
        [
            {
                snax_acc_name: snax_versacore
                bender_target:
                [
                    snax_versacore
                ]
                snax_tcdm_ports: 32
                // Fixed by VersaCore: take_in_new_c, accumulation bound, output bound,
                // subtractions, array shape, data type, start. VersaCoreGen REQUIRES 7.
                snax_num_rw_csr: 7
                snax_num_ro_csr: 5
                snax_versacore_mac_num:
                [
                    1024
                ]
                snax_versacore_input_a_element_width:
                [
                    8
                ]
                snax_versacore_input_a_data_type:
                [
                    SInt
                ]
                snax_versacore_input_b_element_width:
                [
                    8
                ]
                snax_versacore_input_b_data_type:
                [
                    SInt
                ]
                snax_versacore_input_c_element_width:
                [
                    32
                ]
                snax_versacore_input_c_data_type:
                [
                    SInt
                ]
                snax_versacore_output_d_element_width:
                [
                    32
                ]
                snax_versacore_output_d_data_type:
                [
                    SInt
                ]
                snax_versacore_array_input_a_width: 512
                snax_versacore_array_input_b_width: 512
                snax_versacore_array_input_c_width: 8192
                snax_versacore_array_output_d_width: 8192
                snax_versacore_serial_a_width: 512
                snax_versacore_serial_b_width: 512
                snax_versacore_serial_c_d_width: 1024
                snax_versacore_adder_tree_delay: 0
                // [data type][array shape][Mu, Ku, Nu]
                snax_versacore_spatial_unrolling:
                [
                    [
                        [
                            16
                            4
                            16
                        ]
                    ]
                ]
                // Output-stationary only: every dispatch holds one Mu x Nu output block in
                // the accumulator and streams K tiles of A and B through it, which is the
                // dataflow both FlashAttention matmuls want and the only one the
                // output_stationary-only software library builds for.
                snax_versacore_temporal_unrolling:
                [
                    output_stationary
                ]
                snax_streamer_cfg:
                {
                    $ref: "#/snax_versacore_streamer_template"
                }
                // Stride alignment the data generators assert against. The interconnect
                // here is dense (tcdm.sparse_interconnect = false), so no port group is
                // shared and a stride need only be bank-aligned.
                granularity_a: 1
                granularity_b: 1
                granularity_c_d: 1
            }
        ]
        snax_use_custom_ports: false
        num_int_outstanding_loads: 1
        num_int_outstanding_mem: 4
        num_fp_outstanding_loads: 4
        num_fp_outstanding_mem: 4
        num_sequencer_instructions: 16
        num_dtlb_entries: 1
        num_itlb_entries: 1
    }
}
