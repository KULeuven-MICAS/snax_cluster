            datapath_extensions:
            [
                {
                    HasBroadcaster:
                    {
                        inputLength: 256
                        outputLength: 2048
                    }
                }
                // Slots are [read, write] for the one reader_writer: slot 0 is the C read
                // path (the broadcaster above), slot 1 is the D32 write path.
                {
                    HasInt32ToFp16Converter:
                    {
                        // 2048 = the D32 port's beat: 32 TCDM channels x 64 b.
                        dataWidth: 2048
                    }
                }
            ]
        }
        has_transpose: true
        has_C_broadcast: true
        // snaxgen sizes the accelerator's CSR window from these flags, and it MUST agree with
        // the Chisel-generated streamer_csr_addr_map.h. The converter adds 2 registers here --
        // its own user CSR, plus the enable of the reader_writer WRITE host, which was empty
        // before. The flag only covers the first (in the cfg it was written for, the converter
        // shares a host whose enable another flag already paid for), so the second is explicit.
        has_int32_to_fp16_converter: true
        extra_streamer_csr: 1
        snax_library_name: gemmx
    }
