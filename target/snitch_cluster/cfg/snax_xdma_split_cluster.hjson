{
    nr_s1_quadrant: 1
    s1_quadrant:
    {
        nr_clusters: 1
    }
    cluster:
    {
        name: snax_xdma_split_cluster
        bender_target:
        [
            snitch_cluster
            snax_xdma_split_cluster
        ]
        boot_addr: 4096
        cluster_base_addr: 268435456
        cluster_base_offset: 4194304
        cluster_base_hartid: 0
        addr_width: 48
        data_width: 64
        user_width: 3
        tcdm:
        {
            size: 512
            banks: 32
            sparse_interconnect: false
        }
        cluster_periph_size: 64
        zero_mem_size: 64
        dma_data_width: 512
        dma_axi_req_fifo_depth: 16
        dma_req_fifo_depth: 8
        observable_pin_width: 8
        narrow_trans: 4
        wide_trans: 32
        dma_user_width: 1
        enable_debug: false
        vm_support: false
        sram_cfg_expose: true
        sram_cfg_fields:
        {
            ema: 3
            emaw: 2
            emas: 1
        }
        timing:
        {
            lat_comp_fp32: 3
            lat_comp_fp64: 3
            lat_comp_fp16: 2
            lat_comp_fp16_alt: 2
            lat_comp_fp8: 1
            lat_comp_fp8_alt: 1
            lat_noncomp: 1
            lat_conv: 1
            lat_sdotp: 2
            fpu_pipe_config: BEFORE
            narrow_xbar_latency: CUT_ALL_PORTS
            wide_xbar_latency: CUT_ALL_PORTS
            register_core_req: true
            register_core_rsp: true
            register_offload_req: true
            register_offload_rsp: true
            register_ext_narrow: true
            register_ext_wide: true
        }
        hives:
        [
            {
                icache:
                {
                    size: 8
                    sets: 2
                    cacheline: 256
                }
                cores:
                [
                    {
                        isa: rv32ima
                        xssr: false
                        xfrep: false
                        xdma: false
                        xf16: false
                        xf16alt: false
                        xf8: false
                        xf8alt: false
                        xfdotp: false
                        xfvec: false
                        snax_acc_cfg:
                        [
                            {
                                snax_acc_name: snax_streamer_gemmX
                                bender_target:
                                [
                                    snax_gemmX
                                ]
                                snax_tcdm_ports: 56
                                snax_num_rw_csr: 29  // = 4 + (2 + meshCol/4 + meshCol + 1) + 2, by hand; 19 at meshCol=8
                                snax_num_ro_csr: 2
                                // 16x4x16 = 1024 INT8 MAC/cycle, double 8x8x8, at IDENTICAL operand
                                // bandwidth: operand bytes/MAC = 1/meshRow + 1/meshCol, independent of
                                // tileSize, so A stays meshRow*tileSize = 64 B and B stays
                                // tileSize*meshCol = 64 B and the streamer ports are unchanged.
                                snax_gemmx_mesh_row: 16
                                snax_gemmx_tile_size: 4
                                snax_gemmx_mesh_col: 16
                                snax_gemmx_serial_c32_d32_width: 2048
                                snax_gemmx_serial_d8_width: 512
                                with_pipeline: true
                                snax_streamer_cfg:
                                {
                                    data_reader_params:
                                    {
                                        spatial_bounds:
                                        [
                                            [
                                                8
                                            ]
                                            [
                                                8
                                            ]
                                        ]
                                        temporal_dim:
                                        [
                                            6
                                            3
                                        ]
                                        num_channel:
                                        [
                                            8
                                            8
                                        ]
                                        fifo_depth:
                                        [
                                            8
                                            8
                                        ]
                                        configurable_channel:
                                        [
                                            0
                                            0
                                        ]
                                        tcdm_logic_word_size:
                                        [
                                            [
                                                256
                                                128
                                                64
                                            ]
                                            [
                                                256
                                                128
                                                64
                                            ]
                                        ]
                                        datapath_extensions:
                                        [
                                            {
                                                HasTransposer:
                                                {
                                                    row:
                                                    [
                                                        8
                                                    ]
                                                    col:
                                                    [
                                                        8
                                                    ]
                                                    elementWidth:
                                                    [
                                                        8
                                                    ]
                                                }
                                            }
                                            {
                                                HasTransposer:
                                                {
                                                    row:
                                                    [
                                                        8
                                                    ]
                                                    col:
                                                    [
                                                        8
                                                    ]
                                                    elementWidth:
                                                    [
                                                        8
                                                    ]
                                                }
                                            }
                                        ]
                                    }
                                    data_writer_params:
                                    {
                                        spatial_bounds:
                                        [
                                            [
                                                8
                                            ]
                                        ]
                                        temporal_dim:
                                        [
                                            3
                                        ]
                                        num_channel:
                                        [
                                            8
                                        ]
                                        fifo_depth:
                                        [
                                            1
                                        ]
                                        configurable_channel:
                                        [
                                            0
                                        ]
                                        tcdm_logic_word_size:
                                        [
                                            [
                                                256
                                                128
                                                64
                                            ]
                                        ]
                                    }
                                    data_reader_writer_params:
                                    {
                                        spatial_bounds:
                                        [
                                            [
                                                8
                                                4
                                            ]
                                            [
                                                8
                                                4
                                            ]
                                        ]
                                        temporal_dim:
                                        [
                                            3
                                            3
                                        ]
                                        num_channel:
                                        [
                                            32
                                            32
                                        ]
                                        fifo_depth:
                                        [
                                            1
                                            1
                                        ]
                                        configurable_channel:
                                        [
                                            1
                                            0
                                        ]
                                        tcdm_logic_word_size:
                                        [
                                            [
                                                256
                                                128
                                                64
                                            ]
                                            [
                                                256
                                                128
                                                64
                                            ]
                                        ]
                                        datapath_extensions:
                                        [
                                            {
                                                HasBroadcaster:
                                                {
                                                    inputLength: 256
                                                    outputLength: 2048
                                                }
                                            }
                                            {}
                                        ]
                                    }
                                    has_transpose: true
                                    has_C_broadcast: true
                                    snax_library_name: gemmx
                                }
                            }
                        ]
                        snax_use_custom_ports: false
                        num_int_outstanding_loads: 1
                        num_int_outstanding_mem: 4
                        num_fp_outstanding_loads: 4
                        num_fp_outstanding_mem: 4
                        num_sequencer_instructions: 16
                        num_dtlb_entries: 1
                        num_itlb_entries: 1
                    }
                    {
                        isa: rv32ima
                        snax_simd_cfg:
                        {
                            bender_target:
                            [
                                snax_xdma_split_cluster_simd
                            ]
                            cfg_io_width: 32
                            num_channel: 8
                            reader_buffer: 12
                            writer_buffer: 12
                            reader_agu_temporal_dimension: 3
                            writer_agu_temporal_dimension: 3
                            reader_extensions:
                            {
                                // ORDER IS THE CHAIN ORDER: a task arms a subset and data flows through them in
                                // declaration order, so what can be fused into one pass is decided HERE.
                                // Int32ToFp16Converter first lets a GEMM's INT32 output be converted AND
                                // reduced in a single pass (the reduce in tap mode passes the converted tile
                                // through and appends its statistics).
                                HasInt32ToFp16Converter:
                                {
                                    dataWidth: 512
                                }
                                HasElementwiseAdd:
                                {
                                    elementWidth: 32
                                    dataWidth: 512
                                }
                                // computeLanes 16, NOT 32, on the FP16 operators. MEASURED: doubling them bought
                                // 8% latency (1284 -> 1189 cycles/KV tile on FlashAttention) and HALVED SIMD
                                // efficiency, 72% -> 40% of peak -- the extra ALUs sit idle, because the block
                                // stopped being ALU-bound once the sticky-B broadcast removed the replication
                                // pass. 2x the FP units in three operators is not worth 8%.
                                //
                                // StreamElementwise has a second reason: at computeLanes=32 (subCycles=1) the FSM
                                // inserts gap = accLat+1-subCycles = 3 idle cycles between the beats of a
                                // MULTI-operand row, so 2-operand kernels (rmsnorm-fold, softmax-fold, rope) get
                                // SLOWER than at 16 while using twice the area.
                                HasStreamMap:
                                {
                                    dataWidth: 512
                                    elementWidth: 16
                                    computeLanes: 16
                                    func:
                                    [
                                        LINEAR_FP16
                                        EXP_FP16
                                        SILU_FP16
                                    ]
                                    fpPipe: 1
                                }
// computeLanes 16 with accPartials 2 (Track C / C2).
                                //
                                // 8 was the CAP, not a choice: the accumulate recurrence needs
                                // subCycles >= accLat+1 = 4, i.e. computeLanes <= lanes/4 = 8, and at 16 the
                                // FSM inserted gap=2 and landed on the same 4 cycles/beat with twice the ALUs.
                                // Two rotating partials make the same bank re-read only every P*subCycles = 4
                                // cycles, which is exactly the recurrence, so 16 lanes now stream at 2
                                // cycles/beat -- half the reduce time.
                                //
                                // Costs: one extra bank of lanes x FP32 partial registers, plus a per-lane
                                // combinational fold at the row boundary. accPartials defaults to 1, which is
                                // bit-identical to the previous hardware, so this is measurable and revertible.
                                HasStreamReduce:
                                {
                                    dataWidth: 512
                                    elementWidth: 16
                                    computeLanes: 16
                                    op:
                                    [
                                        FMA_FP16
                                        MAX_FP16
                                    ]
                                    fpPipe: 1
                                    treePipe: 1
                                    treeLanes: 2
                                    accPartials: 2
                                }
                                                                HasStreamElementwise:
                                {
                                    dataWidth: 512
                                    elementWidth: 16
                                    computeLanes: 16
                                    op:
                                    [
                                        FMA_FP16
                                    ]
                                    fpPipe: 1
                                }
                                                                HasFp16ToInt8:
                                {
                                    in_elementWidth: 16
                                    out_elementWidth: 8
                                    dataWidth: 512
                                    computeLanes: 16
                                    fpPipe: 1
                                }
                            }
                        }
                        xdma: false
                        xssr: false
                        xfrep: false
                        xf16: false
                        xf16alt: false
                        xf8: false
                        xf8alt: false
                        xfdotp: false
                        xfvec: false
                        num_int_outstanding_loads: 1
                        num_int_outstanding_mem: 4
                        num_fp_outstanding_loads: 4
                        num_fp_outstanding_mem: 4
                        num_sequencer_instructions: 16
                        num_dtlb_entries: 1
                        num_itlb_entries: 1
                    }
                    {
                        isa: rv32ima
                        snax_xdma_cfg:
                        {
                            bender_target:
                            [
                                snax_xdma_split_cluster_xdma
                            ]
                            cfg_io_width: 32
                            max_multicast: 16
                            max_dimension: 5
                            max_mem_size_kiB: 65536
                            reader_buffer: 12
                            writer_buffer: 12
                            reader_agu_temporal_dimension: 5
                            writer_agu_temporal_dimension: 5
                            writer_extensions:
                            {
                                HasVerilogMemset: {}
                            }
                            writer_junctions:
                            {
                                HasElementwiseJunction:
                                {
                                    dataWidth: 512
                                    elemWidth: 16
                                    fpPipe: 1
                                }
                                HasMonoidJunction:
                                {
                                    dataWidth: 512
                                    fpPipe: 1
                                    expLutN: 128
                                }
                                HasTopKJunction:
                                {
                                    dataWidth: 512
                                    k: 8
                                }
                                HasBitwiseJunction:
                                {
                                    dataWidth: 512
                                }
                            }
                            // Reader-side extension socket on the xDMA.
                            //
                            // The four-engine split moved the compute extensions to the SIMD
                            // block and emptied this list. But the Transposer is not compute --
                            // it is a pure wire permutation, matrixOutput(j)(i) := matrixInput(i)(j)
                            // -- so it belongs with data movement, and with the list empty there
                            // was nowhere on this cluster for snax-xdma-transpose to run at all.
                            //
                            // Same declaration as the unsplit cluster, so it generates the id
                            // TRANSPOSERROW8_8COL8_8BIT8_16 that the kernel selects first.
                            //
                            // NOTE: this is the ONLY reader_extensions key in this block. Adding a
                            // second one earlier silently did nothing -- a later duplicate key wins.
                            reader_extensions:
                            {
                                HasTransposer: {row:[8,8], col:[8,8], elementWidth:[8,16]}
                            }
                        }
                        xdma: false
                        xssr: false
                        xfrep: false
                        xf16: false
                        xf16alt: false
                        xf8: false
                        xf8alt: false
                        xfdotp: false
                        xfvec: false
                        num_int_outstanding_loads: 1
                        num_int_outstanding_mem: 4
                        num_fp_outstanding_loads: 4
                        num_fp_outstanding_mem: 4
                        num_sequencer_instructions: 16
                        num_dtlb_entries: 1
                        num_itlb_entries: 1
                    }
                    {
                        isa: rv32ima
                        xdma: true
                        xssr: false
                        xfrep: false
                        xf16: false
                        xf16alt: false
                        xf8: false
                        xf8alt: false
                        xfdotp: false
                        xfvec: false
                        num_int_outstanding_loads: 1
                        num_int_outstanding_mem: 4
                        num_fp_outstanding_loads: 4
                        num_fp_outstanding_mem: 4
                        num_sequencer_instructions: 16
                        num_dtlb_entries: 1
                        num_itlb_entries: 1
                    }
                ]
            }
        ]
